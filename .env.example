# Banco de dados PostgreSQL (Neon, Supabase, Railway...).
# Cole aqui a "connection string" que o provedor mostrar.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Chave usada para assinar o cookie de sessao. Troque por algo aleatorio e longo.
# Em producao o app se recusa a subir sem ela.
SESSION_SECRET="troque-esta-chave-em-producao"
